# Copy to .cursor-api.env (gitignored) and set your Cursor API key.
# Used by the Strategy AI assistant (/ws/control/cursor-agent).

CURSOR_API_KEY=

# Optional overrides:
# CURSOR_AGENT_MODEL=composer-2.5
# CURSOR_AGENT_WORKSPACE=/path/to/repo
# CURSOR_AGENT_MAX_SESSIONS=32
# CURSOR_AGENT_STRICT_ASK_GUARDRAILS=true  # re-enable old Ask-mode tool blocking (off by default)
