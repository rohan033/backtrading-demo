# Copy to .env and broker-specific files as needed. Never commit secrets.

# --- Control plane ---
CONTROL_PLANE_URL=http://localhost:8000
LIVE_ENGINE_PORT_START=9000
LIVE_ENGINE_PORT_END=9999

# --- Live events DB (generated, gitignored) ---
LIVE_EVENTS_DB=live_events.db

# --- Angel One (optional) ---
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=
# Legacy aliases sometimes used in config.py:
API_KEY=
CLIENT_ID=

# --- eToro (optional: copy brokers/etoro templates to .demo.env / .live.env) ---
# ETORO_* vars — see brokers/etoro/env.py

# --- Cursor Strategy AI (optional: .cursor-api.env from .cursor-api.env.example) ---
# CURSOR_API_KEY=

# --- Finnhub news (optional) ---
FINNHUB_API_KEY=
NEWS_POLL_ENABLED=true
NEWS_POLL_INTERVAL_SECONDS=300
NEWS_POLL_REQUEST_DELAY_SECONDS=1.2
NEWS_CACHE_TTL_SECONDS=600
NEWS_CACHE_MAX_ITEMS=50
MARKET_STATUS_CACHE_TTL_SECONDS=1800

# --- Telegram bot (optional: .telegram.env) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
